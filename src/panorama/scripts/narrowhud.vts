"use strict";
// HUD Resize & 4:3 / 5:4 Fix: un-stretches and resizes the Panorama UI.
// The engine lays screens narrower than 16:10 out on a 1440x1080 canvas and stretches it to the
// screen, so the X and Y scales differ. This script measures the real scales on the UI root and
// rescales the root's top-level containers: on narrow screens the UI becomes uniform and as large as
// on a 16:9 screen of the same width; on 16:9, 16:10 and 21:9 it keeps the engine's own canvas. Both
// are multiplied by UI_SIZE (a build-time setting). The shop, the health bar and the crosshair get
// their own corrections below. Runs in the in-game HUD and in the main menu.
(function () {
    var TAG = "[NarrowHUD]";
    var DEBUG = {{DEBUG}};
    var uiSize = {{UI_SIZE}};          // build-time UI size; 1.0 = vanilla size on 16:9 and 16:10
    var HUD_ASPECT = {{HUD_ASPECT}};   // 0 = use the whole screen; e.g. 1.0 = largest centered 1:1 square
    var FOV_ASPECT = {{FOV_ASPECT}};   // personal r_aspectratio (private builds only) for the crosshair; 0 = default
    var FULLSCREEN = { HudCore: 1, HudExperimentsContainer: 1, HudTakeovers: 1, EscapeMenu: 1, PopupManager: 1,
                       ContextMenuManager: 1, TooltipManager: 1, RadialsRoot: 1, LoadInFadeCover: 1, DashboardMain: 1 };
    var SCALEONLY = { CommendNotification: 1, ToastManager: 1, CitadelPartyContainer: 1, CitadelHudCombatLog: 1,
                      HudPerfStatsBasics: 1 };
    // full-screen containers that must NOT be confined to the HUD region: tooltips and context menus are
    // positioned from the cursor and get clipped by a smaller manager; popups (settings) are full-screen UI
    var NOREGION = { PopupManager: 1, ContextMenuManager: 1, TooltipManager: 1 };

    var ctx = $.GetContextPanel();
    var root = null;
    var dbg = null;
    var last = "";
    var lastError = "";   // shown on the debug label; everything else goes to the console only

    function log(m) {
        $.Msg(TAG + " " + m);
        if (m.indexOf("error") >= 0) { lastError = m; }
    }

    function findRoot(p) {
        for (var guard = 0; p && guard < 64; guard++) {
            var t = p.paneltype, id = p.id;
            if (t === "CitadelHud" || t === "CitadelDB" || id === "Hud" || id === "Dashboard") { return p; }
            var parent = p.GetParent();
            if (!parent) { return p; }
            p = parent;
        }
        return p;
    }

    // engine classes such as AspectRatio4x3 ("narrower than 16:10") sit on the UI root or an ancestor
    function hasClassUp(p, cls) {
        for (var guard = 0; p && guard < 64; guard++) {
            if (p.BHasClass(cls)) { return true; }
            p = p.GetParent();
        }
        return false;
    }

    // x offset of a panel inside an ancestor, in real pixels
    function offsetIn(p, ancestor) {
        var x = 0;
        for (var guard = 0; p && p !== ancestor && guard < 64; guard++) { x += p.actualxoffset; p = p.GetParent(); }
        return x;
    }

    // The health bar is anchored to the left edge at its vanilla position by npc_icons.css. The rest of the
    // lower-left group (#StatsAndModsContainer: stat circles, souls, items) is "clamp_width": on a canvas wider
    // than 1920 (UI size below 1) the engine caps it to a centered 1920px band. Keep the bar at the same vanilla
    // offset from that band. u = real px per HudCore unit. 21:9 is left vanilla.
    function fixHealthBar(hudCore, u) {
        var base = (hasClassUp(root, "AspectRatio4x3") || hasClassUp(root, "AspectRatio16x9")) ? 315 :
                   hasClassUp(root, "AspectRatio16x10") ? 199.5 : -1;
        if (base < 0) { return; }
        var hb = hudCore.FindChildTraverse("health_and_abilities_container");
        var sm = hudCore.FindChildTraverse("StatsAndModsContainer");
        if (!hb || !sm) { return; }
        var band = Math.max(0, offsetIn(sm, hudCore) / u);
        hb.style.marginLeft = (base + band).toFixed(2) + "px";
    }

    function keyOf(c) {
        if (c.id && (FULLSCREEN[c.id] || SCALEONLY[c.id])) { return c.id; }
        var names = ["HudCore", "HudTakeovers", "RadialsRoot", "DashboardMain"];
        for (var i = 0; i < names.length; i++) { if (c.BHasClass(names[i])) { return names[i]; } }
        if (c.paneltype === "HudPerfStatsBasics") { return "HudPerfStatsBasics"; }
        return null;
    }

    // The escape menu's dark backdrop should still cover the whole screen while its contents stay in
    // the region: let children overflow the container and stretch the background child over the screen.
    function fixEscapeBackdrop(menu, lw, lh, ox, oy, sx, sy, ux, uy) {
        if (!(ox > 0 || oy > 0)) { return; }
        var bg = menu.FindChild("EscapeBackground");
        if (!bg) { return; }
        menu.style.overflow = "noclip";
        menu.style.backgroundColor = "transparent";            // moved onto the backdrop child below
        bg.style.width = (lw / sx / ux).toFixed(2) + "px";
        bg.style.height = (lh / sy / uy).toFixed(2) + "px";
        bg.style.marginLeft = (-ox / sx / ux).toFixed(2) + "px";
        bg.style.marginTop = (-oy / sy / uy).toFixed(2) + "px";
        bg.style.backgroundColor = root.BHasClass("InHideout") ? "transparent" : "#000000cc";

        // #RightSide carries the menu's dimming gradient (and the friends list): copy the gradient onto a
        // full-screen panel of our own and make #RightSide transparent, so the list stays in the region.
        var fullW = (lw / sx / ux).toFixed(2) + "px", fullH = (lh / sy / uy).toFixed(2) + "px";
        var offX = (-ox / sx / ux).toFixed(2) + "px", offY = (-oy / sy / uy).toFixed(2) + "px";
        var grad = menu.FindChild("NarrowHudEscGrad");
        if (!grad) {
            grad = $.CreatePanel("Panel", menu, "NarrowHudEscGrad");
            grad.hittest = false;
            grad.style.zIndex = "-1";
        }
        grad.style.width = fullW; grad.style.height = fullH;
        grad.style.marginLeft = offX; grad.style.marginTop = offY;
        grad.style.backgroundColor = "gradient( linear, 100% 0%, 0% 0%, from( #040402 ), to( #04040222 ) )";
        var rs = menu.FindChild("RightSide");
        if (rs) { rs.style.backgroundColor = "transparent"; }
        // the two blur strips: extend them outwards to the screen edges (they have no children)
        var extX = ox / sx / ux;
        var lsb = menu.FindChild("LeftStripeBlur");
        if (lsb) { lsb.style.marginLeft = (-extX).toFixed(2) + "px"; lsb.style.width = (1000 + extX).toFixed(2) + "px"; }
        var rsb = menu.FindChild("RightSideBlur");
        if (rsb) { rsb.style.marginRight = (-extX).toFixed(2) + "px"; rsb.style.width = (720 + extX).toFixed(2) + "px"; }
    }

    // The shop's layout is built for the reference canvas width (1920px, or the engine's own width on
    // an unstretched screen, e.g. 1728 on 16:10). With UI Size above 1 the HUD canvas is narrower than
    // that and the shop would collide with the quick-buy panel, so the shop keeps the largest size
    // that still fits: its own canvas is held at the reference width.
    // The shop is also laid out for a 1080px-tall canvas: on a taller canvas it leaves the bottom empty,
    // so give it a 1080px-tall box centered vertically, and move the quick-buy column down with it.
    function fixShop(hudCore, cw, ch, refW) {
        var shop = hudCore.FindChild("CitadelHudHeroShop");
        if (!shop) { return; }
        var s = Math.min(1, cw / refW);                 // shop scale relative to the HUD canvas
        var boxH = Math.min(ch / s, 1080);              // shop canvas height in its own units (16:9 box)
        var offset = Math.max(0, (ch - boxH * s) / 2);  // vertical centering, in HudCore units
        // the whole shop, backdrop included, is the centered box
        shop.style.uiScale = (s * 100).toFixed(4) + "% " + (s * 100).toFixed(4) + "% 100%";
        shop.style.width = (cw / s).toFixed(2) + "px";
        shop.style.height = boxH.toFixed(2) + "px";
        shop.style.marginTop = offset.toFixed(2) + "px";
        var sm = hudCore.FindChildTraverse("StatsAndModsContainer");
        var qb = hudCore.FindChildTraverse("CitadelHudQuickbuy");
        shopMode = { sm: sm, qb: qb, s: s, cw: cw, ch: ch, offset: offset };
        applyShopMode(true);
    }

    // The game places the crosshair pips (bullet spread) and ability reticles in UI units and ignores both
    // our rescale and r_aspectratio (measured: the same pip translate at sizes 0.5 and 1.5, and with and
    // without r_aspectratio). So #crosshair gets its own uniform scale t (real px per unit), chosen with
    // pellet tests so the pips match the real spread:
    //  - 16:9 / 16:10 / 21:9: the engine's own scale, i.e. exactly vanilla.
    //  - narrow (4:3 class): vanilla stretches it (2.00 x 2.37 on 9:8) and overstates the spread. Measured at
    //    rest: 24 units on 9:8 vs 18 on 16:9 for a world drawn 1.58x larger (Hor+), which fits
    //    t = sy * 1440 / 1920 (round; 1.78 on 9:8, 1.5 on exact 4:3).
    //  - a personal r_aspectratio widens the view the game does not know about: t *= screen aspect / FOV_ASPECT.
    var crosshairT = 0, crosshairFov = 1;   // for the debug label
    function fixCrosshair(hudCore, narrow, sx, sy, ux, uy, lw, lh, cw, ch, ox, oy) {
        var cr = hudCore.FindChildTraverse("crosshair");
        if (!cr) { return; }
        var fov = FOV_ASPECT > 0 ? (lw / lh) / FOV_ASPECT : 1;
        var t = (narrow ? sy * 1440 / 1920 : sx) * fov;
        crosshairT = t; crosshairFov = fov;
        var kx = t / (sx * ux), ky = t / (sy * uy);           // relative to HudCore
        cr.style.uiScale = (kx * 100).toFixed(4) + "% " + (ky * 100).toFixed(4) + "% 100%";
        cr.style.width = (cw / kx).toFixed(2) + "px";        // own units, covers HudCore
        cr.style.height = (ch / ky).toFixed(2) + "px";
        fixTargetElements(hudCore, cr, sx, sy, t, lw, lh, ox, oy);
    }

    // The unit-target diamond and the lock-on marker are placed by the engine on its own canvas: root
    // units (sx x sy real px per unit, stretched on narrow screens) measured from the screen's top-left
    // corner, whatever the parent's scale and offset (measured 2026-10-18: a unit at the screen center
    // got position 720 = 1440 px / sx inside an element that started 160 px into the screen). The game
    // also keeps a unit targeted from the same geometry, so a shifted element shifts the targeting cone.
    // Give the two element panels exactly their vanilla geometry back: the engine's scale and the whole
    // screen, starting at the screen corner (negative margins reach outside the HUD region; the
    // ancestors up to HudCore must not clip). The elements are created per hero, so this runs every tick.
    var TARGET_TYPES = { Citadel_AbilityHUDElement_UnitTarget: 1, Citadel_AbilityHUDElement_LockOn: 1 };
    var targetElems = [];   // for the debug label
    function fixTargetElements(hudCore, cr, sx, sy, t, lw, lh, ox, oy) {
        targetElems = [];
        var stack = [cr], seen = 0;
        while (stack.length && seen < 400) {
            var p = stack.pop(); seen++;
            var n = p.GetChildCount();
            for (var i = 0; i < n; i++) {
                var c = p.GetChild(i);
                if (!c) { continue; }
                if (TARGET_TYPES[c.paneltype]) {
                    var px = p.actualuiscale_x > 0 ? p.actualuiscale_x : t;   // parent's real px per unit
                    var py = p.actualuiscale_y > 0 ? p.actualuiscale_y : t;
                    var kx = sx / px, ky = sy / py;                           // relative to the parent
                    c.style.uiScale = (kx * 100).toFixed(4) + "% " + (ky * 100).toFixed(4) + "% 100%";
                    c.style.width = (lw / sx).toFixed(2) + "px";              // own units: the whole screen
                    c.style.height = (lh / sy).toFixed(2) + "px";
                    c.style.marginLeft = (-ox / px).toFixed(2) + "px";        // parent units: back to the
                    c.style.marginRight = (-ox / px).toFixed(2) + "px";       // screen corner
                    c.style.marginTop = (-oy / py).toFixed(2) + "px";
                    c.style.marginBottom = (-oy / py).toFixed(2) + "px";
                    for (var q = p, g = 0; q && q !== hudCore && g < 16; q = q.GetParent(), g++) {
                        q.style.overflow = "noclip";
                    }
                    targetElems.push(c);
                } else {
                    stack.push(c);
                }
            }
        }
    }

    // Debug: where the engine put the first target instance (unit_target_instance / lock_on_instance):
    // its style position and transform (parent units), real px offset in HudCore, and the element's scale.
    function offsetInY(p, ancestor) {
        var y = 0;
        for (var guard = 0; p && p !== ancestor && guard < 64; guard++) { y += p.actualyoffset; p = p.GetParent(); }
        return y;
    }
    function findInstance(elem) {
        var stack = [elem], seen = 0;
        while (stack.length && seen < 200) {
            var p = stack.pop(); seen++;
            if (p.BHasClass("unit_target_instance") || p.BHasClass("lock_on_instance")) { return p; }
            var n = p.GetChildCount();
            for (var i = 0; i < n; i++) { var c = p.GetChild(i); if (c) { stack.push(c); } }
        }
        return null;
    }
    function targetDebug(hudCore) {
        var s = "";
        for (var i = 0; i < targetElems.length; i++) {
            var e = targetElems[i];
            if (!e.IsValid()) { continue; }
            s += "\n" + e.paneltype.replace("Citadel_AbilityHUDElement_", "") + " scale=" +
                 Number(e.actualuiscale_x).toFixed(3) + "," + Number(e.actualuiscale_y).toFixed(3) +
                 " box=" + Number(e.actuallayoutwidth).toFixed(0) + "x" + Number(e.actuallayoutheight).toFixed(0) +
                 " at=" + offsetIn(e, hudCore).toFixed(0) + "," + offsetInY(e, hudCore).toFixed(0) + "px";
            var inst = findInstance(e);
            if (inst) {
                s += " inst pos=" + inst.style.position + " tr=" + inst.style.transform +
                     " size=" + Number(inst.actuallayoutwidth).toFixed(0) + "x" + Number(inst.actuallayoutheight).toFixed(0) +
                     " at=" + offsetIn(inst, hudCore).toFixed(0) + "," + offsetInY(inst, hudCore).toFixed(0) + "px";
            } else { s += " (no instance)"; }
        }
        return s || "\nno target elements";
    }

    // While the shop is open, the lower-left group (#StatsAndModsContainer: quick-buy column, souls, items) is
    // shown at the shop's scale so the quick-buy matches the shop; closed, it is back to vanilla (100%, full
    // size). Vanilla already transitions this container's ui-scale. Sizes are in the container's own units.
    // Polled every 50 ms (watchShop) so the switch follows the engine's gShopOpen class without a visible lag.
    var shopMode = null, shopKey = "";
    function applyShopMode(force) {
        var m = shopMode;
        if (!m || !m.sm || !m.sm.IsValid()) { return; }
        var open = m.sm.BHasClass("gShopOpen") && m.s < 0.999;
        var key = [open, m.s, m.cw, m.ch, m.offset].join("|");
        if (!force && key === shopKey) { return; }
        shopKey = key;
        var k = open ? m.s : 1;
        m.sm.style.uiScale = (k * 100).toFixed(4) + "% " + (k * 100).toFixed(4) + "% 100%";
        m.sm.style.width = open ? (m.cw / k).toFixed(2) + "px" : "100%";
        m.sm.style.height = open ? (m.ch / k).toFixed(2) + "px" : "100%";
        // the quick-buy column starts at the top of the shop box (offset is in HudCore units)
        if (m.qb && m.qb.IsValid()) { m.qb.style.marginTop = (m.offset / k).toFixed(2) + "px"; }
    }

    function watchShop() {
        try { applyShopMode(false); } catch (e) { log("shop error: " + e); }
        $.Schedule(0.05, watchShop);
    }

    function apply(force) {
        var sx = root.actualuiscale_x, sy = root.actualuiscale_y;
        var lw = root.actuallayoutwidth, lh = root.actuallayoutheight;   // real pixels
        if (!(lw > 0) || !(lh > 0) || !(sx > 0) || !(sy > 0)) { return; }   // layout not ready yet
        // HUD region: the whole screen, or the largest centered HUD_ASPECT box inside it
        var rw = lw, rh = lh;
        if (HUD_ASPECT > 0) {
            if (HUD_ASPECT <= lw / lh) { rw = lh * HUD_ASPECT; } else { rh = lw / HUD_ASPECT; }
        }
        var ox = (lw - rw) / 2, oy = (lh - rh) / 2;                       // region offset, real px
        // reference canvas width: narrow screens (engine class AspectRatio4x3: 1440x1080 canvas, stretched
        // unless the screen is exactly 4:3) get the 1920px a 16:9 layout expects; 16:9, 16:10 and 21:9 keep
        // the engine's own canvas width, so UI Size 1.0 leaves them exactly vanilla
        var narrow = hasClassUp(root, "AspectRatio4x3");
        var refW = narrow ? 1920 : lw / sx;
        // reference scale: that canvas fitted to the region width; never enlarge
        var tRef = Math.min(sx, sy, rw / refW);
        var ux = tRef * uiSize / sx, uy = tRef * uiSize / sy;
        var key = [sx, sy, lw, lh, uiSize, narrow].join("|");
        var changed = force || key !== last;
        last = key;
        var state = "px=" + lw.toFixed(0) + "x" + lh.toFixed(0) + " scale=" + sx.toFixed(3) + "," + sy.toFixed(3) +
            " size=" + uiSize.toFixed(2) + (narrow ? " narrow" : " ref=" + refW.toFixed(0)) +
            " -> ui-scale " + (ux * 100).toFixed(2) + "% " + (uy * 100).toFixed(2) + "%";
        if (changed) { log(state + " region=" + rw.toFixed(0) + "x" + rh.toFixed(0)); }
        var n = root.GetChildCount(), others = [], hudCore = null;
        for (var i = 0; i < n; i++) {
            var c = root.GetChild(i);
            if (!c) { continue; }
            var k = keyOf(c);
            if (!k) { others.push((c.id || "-") + ":" + c.paneltype); continue; }
            if (k === "HudCore") { hudCore = c; }
            var cx = ux, cy = uy;
            if (k === "PopupManager") { cx = tRef / sx; cy = tRef / sy; }   // popups (settings) ignore UI Size
            c.style.uiScale = (cx * 100).toFixed(4) + "% " + (cy * 100).toFixed(4) + "% 100%";
            if (NOREGION[k]) {
                c.style.width = (lw / sx / cx).toFixed(2) + "px";
                c.style.height = (lh / sy / cy).toFixed(2) + "px";
                c.style.marginLeft = "0px"; c.style.marginRight = "0px";
                c.style.marginTop = "0px"; c.style.marginBottom = "0px";
            } else if (FULLSCREEN[k]) {
                // size in the container's own (scaled) units so it covers exactly the region;
                // symmetric margins (root units) place it correctly whether it is left-aligned or centered
                c.style.width = (rw / sx / ux).toFixed(2) + "px";
                c.style.height = (rh / sy / uy).toFixed(2) + "px";
                c.style.marginLeft = (ox / sx).toFixed(2) + "px";
                c.style.marginRight = (ox / sx).toFixed(2) + "px";
                c.style.marginTop = (oy / sy).toFixed(2) + "px";
                c.style.marginBottom = (oy / sy).toFixed(2) + "px";
                if (k === "EscapeMenu") { fixEscapeBackdrop(c, lw, lh, ox, oy, sx, sy, ux, uy); }
                if (k === "HudCore") {
                    fixShop(c, rw / sx / ux, rh / sy / uy, refW);
                    fixHealthBar(c, sx * ux);
                    fixCrosshair(c, narrow, sx, sy, ux, uy, lw, lh, rw / sx / ux, rh / sy / uy, ox, oy);
                }
            } else if (ox > 0 || oy > 0) {
                // edge-anchored containers: keep them inside the region (margins are in the root's units)
                c.style.marginLeft = (ox / sx).toFixed(2) + "px";
                c.style.marginRight = (ox / sx).toFixed(2) + "px";
            }
        }
        if (changed) { log("unmatched root children: " + others.join(" ")); }
        if (DEBUG && dbg) {
            // line 1: the scale state; line 2 (HUD): canvas size, health bar and lower-left group x in canvas
            // units; line 3 (HUD): real px per unit at a crosshair pip, the target scale and the game's pip offset
            var u = sx * ux, extra = "canvas=" + (rw / u).toFixed(0) + "x" + (rh / (sy * uy)).toFixed(0);
            if (hudCore) {
                var hb = hudCore.FindChildTraverse("health_and_abilities_container");
                var sm = hudCore.FindChildTraverse("StatsAndModsContainer");
                if (hb) { extra += "  hb x=" + (offsetIn(hb, hudCore) / u).toFixed(1); }
                if (sm) { extra += "  sm x=" + (offsetIn(sm, hudCore) / u).toFixed(1); }
                try {
                    var cr = hudCore.FindChildTraverse("crosshair");
                    var rp = cr && cr.FindChildTraverse("RightPip");
                    if (rp) {
                        extra += "\npip scale=" + Number(rp.actualuiscale_x).toFixed(3) + "," + Number(rp.actualuiscale_y).toFixed(3) +
                                 " target=" + crosshairT.toFixed(3) + " fov=" + crosshairFov.toFixed(3) + " tr=" + rp.style.transform;
                        extra += " HudCore at=" + offsetIn(hudCore, root).toFixed(0) + "," + offsetInY(hudCore, root).toFixed(0) + "px" +
                                 " cr at=" + offsetIn(cr, hudCore).toFixed(0) + "," + offsetInY(cr, hudCore).toFixed(0) + "px";
                        extra += targetDebug(hudCore);
                    } else { extra += "\npips not found"; }
                } catch (e) { extra += "\npips error " + e; }
            }
            dbg.text = state + "\n" + extra + (lastError ? "\n" + lastError : "");
        }
    }

    function tick() {
        try {
            if (!root) { root = findRoot(ctx); }
            apply(false);
        } catch (e) { log("error: " + e); }
        $.Schedule(0.5, tick);
    }

    function init() {
        try {
            root = findRoot(ctx);
            if (DEBUG) {
                var isMenu = (root.paneltype === "CitadelDB" || root.id === "Dashboard");
                dbg = $.CreatePanel("Label", root, isMenu ? "NarrowHudDebugMenu" : "NarrowHudDebugHud");
                dbg.style.position = isMenu ? "40px 700px 0px" : "40px 360px 0px";
                dbg.style.color = isMenu ? "#00ccff" : "#00ff00";
                dbg.style.zIndex = "2000000";
                dbg.style.fontSize = "20px";
                dbg.style.backgroundColor = "#000000c0";
                dbg.style.padding = "6px";
                dbg.text = TAG + " debug";
            }
            log("context=" + ctx.paneltype + "#" + ctx.id);
            apply(true);
        } catch (e) { log("init error: " + e); }
        $.Schedule(0.5, tick);
        $.Schedule(0.05, watchShop);
    }

    $.Schedule(0.1, init);
})();
