"use strict";
// 4:3 / 5:4 Fix & HUD Resize: un-stretches and resizes the Panorama UI.
// The engine lays screens narrower than 16:10 out on a 1440x1080 canvas and stretches it to the
// screen, so the X and Y scales differ. This script measures the real scales on the UI root and
// rescales the root's top-level containers: on narrow screens the UI becomes uniform and as large as
// on a 16:9 screen of the same width; on 16:9, 16:10 and 21:9 it keeps the engine's own canvas. Both
// are multiplied by UI_SIZE (a build-time setting). The shop, the health bar and the crosshair get
// their own corrections below. Runs in the in-game HUD and in the main menu.
(function () {
    var TAG = "[NarrowHUD]";
    var DEBUG = {{DEBUG}};
    var BUILD_ID = "{{BUILD_ID}}";     // build time, to tell a hot-reloaded script from the one loaded at start
    // Development hot reload: install.py --loose writes the version number into this literal (same width)
    // and installs layout/narrowhud_dev_<n>.xml for it; 0 (a normal build) = no hot reload. See probeReload.
    var DEV_SEQ = parseInt("000000", 10);
    var uiSize = {{UI_SIZE}};          // build-time UI size; 1.0 = vanilla size on 16:9 and 16:10
    var HUD_ASPECT = {{HUD_ASPECT}};   // 0 = use the whole screen; e.g. 1.0 = largest centered 1:1 square
    var FOV_ASPECT = {{FOV_ASPECT}};   // personal r_aspectratio (private builds only) for the crosshair; 0 = default
    var FULLSCREEN = { HudCore: 1, HudExperimentsContainer: 1, HudTakeovers: 1, EscapeMenu: 1, PopupManager: 1,
                       ContextMenuManager: 1, TooltipManager: 1, RadialsRoot: 1, LoadInFadeCover: 1, DashboardMain: 1 };
    var SCALEONLY = { CommendNotification: 1, ToastManager: 1, CitadelPartyContainer: 1, CitadelHudCombatLog: 1,
                      HudPerfStatsBasics: 1 };
    // full-screen containers that must NOT be confined to the HUD region: tooltips and context menus are
    // positioned from the cursor and get clipped by a smaller manager; popups (settings) are full-screen UI
    var NOREGION = { PopupManager: 1, ContextMenuManager: 1, TooltipManager: 1 };
    // containers laid out at the menu scale (the game's own canvas width), not the HUD's (see apply)
    var MENUS = { DashboardMain: 1, EscapeMenu: 1 };
    var menuFitK = 1, popupVanillaK = 1;

    // Give a panel its own scale k relative to its parent and cover the parent with it (less the insets, parent
    // units, that its margins take). Only once per k and parent size; k = 1 on a panel never scaled leaves it alone.
    function fitPanel(p, k, insetW, insetH) {
        var parent = p.GetParent();
        var ux = parent && parent.actualuiscale_x, uy = parent && parent.actualuiscale_y;
        if (!(ux > 0) || !(uy > 0) || !(parent.actuallayoutwidth > 0)) { return; }
        var pw = parent.actuallayoutwidth / ux - (insetW || 0), ph = parent.actuallayoutheight / uy - (insetH || 0);
        var key = k.toFixed(4) + "/" + pw.toFixed(0) + "x" + ph.toFixed(0), had = p.GetAttributeString("narrowhud_fit", "");
        if (had === key || (!had && Math.abs(k - 1) < 0.0001)) { return; }
        p.style.uiScale = (k * 100).toFixed(4) + "% " + (k * 100).toFixed(4) + "% 100%";
        p.style.width = (pw / k).toFixed(2) + "px";
        p.style.height = (ph / k).toFixed(2) + "px";
        p.SetAttributeString("narrowhud_fit", key);
    }

    var ctx = $.GetContextPanel();
    var root = null;
    var dbg = null;
    var last = "";
    var lastError = "";   // shown on the debug label; everything else goes to the console only
    var lastDbgText = "", lastDbgTime = 0;

    function log(m) {
        $.Msg(TAG + " " + m);
        if (m.indexOf("error") >= 0) { lastError = m; }
    }

    function findRoot(p) {
        for (var guard = 0; p && guard < 64; guard++) {
            var t = p.paneltype, id = p.id;
            if (t === "CitadelHud" || t === "CitadelDB" || id === "Hud" || id === "Dashboard") { return p; }
            var parent = p.GetParent();
            if (!parent) { return p; }
            p = parent;
        }
        return p;
    }

    // engine classes such as AspectRatio4x3 ("narrower than 16:10") sit on the UI root or an ancestor
    function hasClassUp(p, cls) {
        for (var guard = 0; p && guard < 64; guard++) {
            if (p.BHasClass(cls)) { return true; }
            p = p.GetParent();
        }
        return false;
    }

    // x offset of a panel inside an ancestor, in real pixels
    function offsetIn(p, ancestor) {
        var x = 0;
        for (var guard = 0; p && p !== ancestor && guard < 64; guard++) { x += p.actualxoffset; p = p.GetParent(); }
        return x;
    }

    // The health bar is anchored to the left edge at its vanilla position by npc_icons.css. The rest of the
    // lower-left group (#StatsAndModsContainer: stat circles, souls, items) is "clamp_width": on a canvas wider
    // than 1920 (UI size below 1) the engine caps it to a centered 1920px band. Keep the bar at the same vanilla
    // offset from that band. u = real px per HudCore unit. 21:9 is left vanilla.
    function fixHealthBar(hudCore, u) {
        var base = (hasClassUp(root, "AspectRatio4x3") || hasClassUp(root, "AspectRatio16x9")) ? 315 :
                   hasClassUp(root, "AspectRatio16x10") ? 199.5 : -1;
        if (base < 0) { return; }
        var hb = hudCore.FindChildTraverse("health_and_abilities_container");
        var sm = hudCore.FindChildTraverse("StatsAndModsContainer");
        if (!hb || !sm) { return; }
        var band = Math.max(0, offsetIn(sm, hudCore) / u);
        hb.style.marginLeft = (base + band).toFixed(2) + "px";
    }

    function keyOf(c) {
        if (c.id && (FULLSCREEN[c.id] || SCALEONLY[c.id])) { return c.id; }
        var names = ["HudCore", "HudTakeovers", "RadialsRoot", "DashboardMain"];
        for (var i = 0; i < names.length; i++) { if (c.BHasClass(names[i])) { return names[i]; } }
        if (c.paneltype === "HudPerfStatsBasics") { return "HudPerfStatsBasics"; }
        return null;
    }

    // The escape menu's dark backdrop should still cover the whole screen while its contents stay in
    // the region: let children overflow the container and stretch the background child over the screen.
    function fixEscapeBackdrop(menu, lw, lh, ox, oy, sx, sy, ux, uy) {
        if (!(ox > 0 || oy > 0)) { return; }
        var bg = menu.FindChild("EscapeBackground");
        if (!bg) { return; }
        menu.style.overflow = "noclip";
        menu.style.backgroundColor = "transparent";            // moved onto the backdrop child below
        bg.style.width = (lw / sx / ux).toFixed(2) + "px";
        bg.style.height = (lh / sy / uy).toFixed(2) + "px";
        bg.style.marginLeft = (-ox / sx / ux).toFixed(2) + "px";
        bg.style.marginTop = (-oy / sy / uy).toFixed(2) + "px";
        bg.style.backgroundColor = root.BHasClass("InHideout") ? "transparent" : "#000000cc";

        // #RightSide carries the menu's dimming gradient (and the friends list): copy the gradient onto a
        // full-screen panel of our own and make #RightSide transparent, so the list stays in the region.
        var fullW = (lw / sx / ux).toFixed(2) + "px", fullH = (lh / sy / uy).toFixed(2) + "px";
        var offX = (-ox / sx / ux).toFixed(2) + "px", offY = (-oy / sy / uy).toFixed(2) + "px";
        var grad = menu.FindChild("NarrowHudEscGrad");
        if (!grad) {
            grad = $.CreatePanel("Panel", menu, "NarrowHudEscGrad");
            grad.hittest = false;
            grad.style.zIndex = "-1";
        }
        grad.style.width = fullW; grad.style.height = fullH;
        grad.style.marginLeft = offX; grad.style.marginTop = offY;
        grad.style.backgroundColor = "gradient( linear, 100% 0%, 0% 0%, from( #040402 ), to( #04040222 ) )";
        var rs = menu.FindChild("RightSide");
        if (rs) { rs.style.backgroundColor = "transparent"; }
        // the two blur strips: extend them outwards to the screen edges (they have no children)
        var extX = ox / sx / ux;
        var lsb = menu.FindChild("LeftStripeBlur");
        if (lsb) { lsb.style.marginLeft = (-extX).toFixed(2) + "px"; lsb.style.width = (1000 + extX).toFixed(2) + "px"; }
        var rsb = menu.FindChild("RightSideBlur");
        if (rsb) { rsb.style.marginRight = (-extX).toFixed(2) + "px"; rsb.style.width = (720 + extX).toFixed(2) + "px"; }
    }

    // The shop's layout is built for the reference canvas width (1920px, or the engine's own width on
    // an unstretched screen, e.g. 1728 on 16:10), so its own canvas is held at that width whatever the
    // UI Size: it always fills the screen width like a vanilla 16:9 shop (larger sizes would make it
    // collide with the quick-buy panel, smaller ones would leave most of the screen empty).
    // It is laid out for a 1080px-tall canvas: on a taller canvas the shop takes the whole height and its
    // fixed-height parts (main window, build editor backdrop, quick-buy queue) grow by the extra height.
    // Below the main window vanilla leaves 100px for the HUD's ability bar (which stays visible); that bar is
    // HUD-sized, 1/s shop units per HUD unit, so the space is kept at 100 HUD units.
    var SHOP_REF_H = 1080, SHOP_MAIN_H = 960, SHOP_MAIN_TOP = 20, SHOP_MAIN_BOTTOM = 100, SHOP_BUILDBG_INSET = 74,
        QUEUE_MAX_H = 600, QUEUE_SHOW_H = 500;
    function fixShop(hudCore, cw, ch, refW) {
        var shop = hudCore.FindChild("CitadelHudHeroShop");
        if (!shop) { return; }
        var s = cw / refW;                              // shop scale relative to the HUD canvas
        var shopH = ch / s;                             // shop canvas height in its own units
        var extra = Math.max(0, shopH - SHOP_REF_H);    // height beyond the 16:9 layout
        var mainH = shopH - SHOP_MAIN_TOP - SHOP_MAIN_BOTTOM / s;
        shop.style.uiScale = (s * 100).toFixed(4) + "% " + (s * 100).toFixed(4) + "% 100%";
        shop.style.width = refW.toFixed(2) + "px";
        shop.style.height = shopH.toFixed(2) + "px";
        shop.style.marginTop = "0px";
        var main = shop.FindChildTraverse("MainPanel");
        if (main) { main.style.height = mainH.toFixed(2) + "px"; }
        var sm = hudCore.FindChildTraverse("StatsAndModsContainer");
        var qb = hudCore.FindChildTraverse("CitadelHudQuickbuy");
        var qc = qb && qb.FindChildTraverse("QuickBuyQueueContainer");
        var build = shop.FindChildTraverse("ShopModsSelectedBuild");
        var filtered = shop.FindChildTraverse("ShopModsFiltered");
        shopMode = { shop: shop, sm: sm, stats: hudCore.FindChild("hudActivePlayerStats"),
                     builds: hudCore.FindChild("CitadelHudHeroBuilds"),
                     queue: qc && findClass(qc, "QuickbuyQueueOuter"),
                     lists: shop.FindChildTraverse("ShopModListsContainer"), filtered: filtered,
                     tiers: filtered && filtered.FindChildTraverse("ModTiers"), mainH: mainH,
                     buildBg: build && findClass(build, "BuildBG"), s: s, cw: cw, ch: ch, extra: extra,
                     buildBgH: mainH - SHOP_BUILDBG_INSET };
        applyShopMode(true);
    }

    // first descendant (breadth-first) with a class
    function findClass(p, cls) {
        var queue = [p];
        for (var seen = 0; queue.length && seen < 400; seen++) {
            var q = queue.shift();
            var n = q.GetChildCount();
            for (var i = 0; i < n; i++) {
                var c = q.GetChild(i);
                if (!c) { continue; }
                if (c.BHasClass(cls)) { return c; }
                queue.push(c);
            }
        }
        return null;
    }

    // The game places the crosshair pips (bullet spread) and ability reticles in UI units and ignores both
    // our rescale and r_aspectratio (measured: the same pip translate at sizes 0.5 and 1.5, and with and
    // without r_aspectratio). So #crosshair gets its own uniform scale t (real px per unit), chosen with
    // pellet tests so the pips match the real spread:
    //  - 16:9 / 16:10 / 21:9: the engine's own scale, i.e. exactly vanilla.
    //  - narrow (4:3 class): vanilla stretches it (2.00 x 2.37 on 9:8) and overstates the spread. Measured at
    //    rest: 24 units on 9:8 vs 18 on 16:9 for a world drawn 1.58x larger (Hor+), which fits
    //    t = sy * 1440 / 1920 (round; 1.78 on 9:8, 1.5 on exact 4:3).
    //  - a personal r_aspectratio widens the view the game does not know about: t *= screen aspect / FOV_ASPECT.
    var crosshairT = 0, crosshairFov = 1;   // for the debug label
    function fixCrosshair(hudCore, narrow, sx, sy, ux, uy, lw, lh, cw, ch, ox, oy) {
        var cr = hudCore.FindChildTraverse("crosshair");
        if (!cr) { return; }
        var fov = FOV_ASPECT > 0 ? (lw / lh) / FOV_ASPECT : 1;
        var t = (narrow ? sy * 1440 / 1920 : sx) * fov;
        crosshairT = t; crosshairFov = fov;
        var kx = t / (sx * ux), ky = t / (sy * uy);           // relative to HudCore
        cr.style.uiScale = (kx * 100).toFixed(4) + "% " + (ky * 100).toFixed(4) + "% 100%";
        cr.style.width = (cw / kx).toFixed(2) + "px";        // own units, covers HudCore
        cr.style.height = (ch / ky).toFixed(2) + "px";
        fixTargetElements(hudCore, cr, sx, sy, t, lw, lh, ox, oy);
    }

    // The unit-target diamond and the lock-on marker are placed by the engine on its own canvas: root
    // units (sx x sy real px per unit, stretched on narrow screens) measured from the screen's top-left
    // corner, whatever the parent's scale and offset (measured 2026-10-18: a unit at the screen center
    // got position 720 = 1440 px / sx inside an element that started 160 px into the screen). The game
    // also keeps a unit targeted from the same geometry, so a shifted element shifts the targeting cone.
    // Give the two element panels exactly their vanilla geometry back: the engine's scale and the whole
    // screen, starting at the screen corner (negative margins reach outside the HUD region; the
    // ancestors up to HudCore must not clip). The elements are created per hero, so this runs every tick.
    var TARGET_TYPES = { Citadel_AbilityHUDElement_UnitTarget: 1, Citadel_AbilityHUDElement_LockOn: 1 };
    var targetElems = [];   // for the debug label
    function fixTargetElements(hudCore, cr, sx, sy, t, lw, lh, ox, oy) {
        targetElems = [];
        var stack = [cr], seen = 0;
        while (stack.length && seen < 400) {
            var p = stack.pop(); seen++;
            var n = p.GetChildCount();
            for (var i = 0; i < n; i++) {
                var c = p.GetChild(i);
                if (!c) { continue; }
                if (TARGET_TYPES[c.paneltype]) {
                    var px = p.actualuiscale_x > 0 ? p.actualuiscale_x : t;   // parent's real px per unit
                    var py = p.actualuiscale_y > 0 ? p.actualuiscale_y : t;
                    var kx = sx / px, ky = sy / py;                           // relative to the parent
                    c.style.uiScale = (kx * 100).toFixed(4) + "% " + (ky * 100).toFixed(4) + "% 100%";
                    c.style.width = (lw / sx).toFixed(2) + "px";              // own units: the whole screen
                    c.style.height = (lh / sy).toFixed(2) + "px";
                    c.style.marginLeft = (-ox / px).toFixed(2) + "px";        // parent units: back to the
                    c.style.marginRight = (-ox / px).toFixed(2) + "px";       // screen corner
                    c.style.marginTop = (-oy / py).toFixed(2) + "px";
                    c.style.marginBottom = (-oy / py).toFixed(2) + "px";
                    for (var q = p, g = 0; q && q !== hudCore && g < 16; q = q.GetParent(), g++) {
                        q.style.overflow = "noclip";
                    }
                    targetElems.push(c);
                } else {
                    stack.push(c);
                }
            }
        }
    }

    // Debug: where the engine put the first target instance (unit_target_instance / lock_on_instance):
    // its style position and transform (parent units), real px offset in HudCore, and the element's scale.
    function offsetInY(p, ancestor) {
        var y = 0;
        for (var guard = 0; p && p !== ancestor && guard < 64; guard++) { y += p.actualyoffset; p = p.GetParent(); }
        return y;
    }
    function findInstance(elem) {
        var stack = [elem], seen = 0;
        while (stack.length && seen < 200) {
            var p = stack.pop(); seen++;
            if (p.BHasClass("unit_target_instance") || p.BHasClass("lock_on_instance")) { return p; }
            var n = p.GetChildCount();
            for (var i = 0; i < n; i++) { var c = p.GetChild(i); if (c) { stack.push(c); } }
        }
        return null;
    }
    function targetDebug(hudCore) {
        var s = "";
        for (var i = 0; i < targetElems.length; i++) {
            var e = targetElems[i];
            if (!e.IsValid()) { continue; }
            s += "\n" + e.paneltype.replace("Citadel_AbilityHUDElement_", "") + " scale=" +
                 Number(e.actualuiscale_x).toFixed(3) + "," + Number(e.actualuiscale_y).toFixed(3) +
                 " box=" + Number(e.actuallayoutwidth).toFixed(0) + "x" + Number(e.actuallayoutheight).toFixed(0) +
                 " at=" + offsetIn(e, hudCore).toFixed(0) + "," + offsetInY(e, hudCore).toFixed(0) + "px";
            var inst = findInstance(e);
            if (inst) {
                s += " inst pos=" + inst.style.position + " tr=" + inst.style.transform +
                     " size=" + Number(inst.actuallayoutwidth).toFixed(0) + "x" + Number(inst.actuallayoutheight).toFixed(0) +
                     " at=" + offsetIn(inst, hudCore).toFixed(0) + "," + offsetInY(inst, hudCore).toFixed(0) + "px";
            } else { s += " (no instance)"; }
        }
        return s || "\nno target elements";
    }

    // While the shop is open, the lower-left group (#StatsAndModsContainer: quick-buy column, souls, items, and
    // its sibling #hudActivePlayerStats: the weapon / spirit / vitality badges and stat list), and the build
    // editor's left panel (#CitadelHudHeroBuilds) are shown at the shop's scale so they match the shop; closed,
    // they are back to vanilla (100%, full size). Vanilla already
    // transitions #StatsAndModsContainer's ui-scale. Sizes are in the containers' own units.
    // The quick-buy queue and the build editor's backdrop grow with the shop's extra height (vanilla values
    // when there is none; the queue's 500px cap is vanilla's for the queue shown outside the shop).
    // Polled every 50 ms (watchShop) so the switch follows the engine's gShopOpen / gEditingBuilds classes and
    // the catalog page without a visible lag.
    var shopMode = null, shopKey = "";
    function applyShopMode(force) {
        var m = shopMode;
        if (!m || !m.sm || !m.sm.IsValid()) { return; }
        var open = m.sm.BHasClass("gShopOpen");
        var editing = m.shop.IsValid() && m.shop.BHasClass("gEditingBuilds");
        var tab = "";
        try { tab = open ? catalogTab(m) : ""; } catch (e) { log("catalog tab error: " + e); }
        try { fixCatalog(m, tab, force); } catch (e) { log("catalog error: " + e); }   // cheap, every poll
        var key = [open, editing, tab, m.s, m.cw, m.ch].join("|");
        if (!force && key === shopKey) { return; }
        shopKey = key;
        var scaled = open && Math.abs(m.s - 1) > 0.001;
        var k = scaled ? m.s : 1;
        var panels = [m.sm, m.stats];
        for (var i = 0; i < panels.length; i++) {
            var p = panels[i];
            if (!p || !p.IsValid()) { continue; }
            p.style.uiScale = (k * 100).toFixed(4) + "% " + (k * 100).toFixed(4) + "% 100%";
            p.style.width = scaled ? (m.cw / k).toFixed(2) + "px" : "100%";
            p.style.height = scaled ? (m.ch / k).toFixed(2) + "px" : "100%";
        }
        // the build editor's left panel (520px wide, HUD-sized) would reach over the shop's tab buttons
        if (m.builds && m.builds.IsValid()) {
            m.builds.style.uiScale = (k * 100).toFixed(4) + "% " + (k * 100).toFixed(4) + "% 100%";
            m.builds.style.height = scaled ? (m.ch / k).toFixed(2) + "px" : "100%";
        }
        if (m.queue && m.queue.IsValid()) {
            m.queue.style.maxHeight = (open ? QUEUE_MAX_H + m.extra : QUEUE_SHOW_H).toFixed(2) + "px";
        }
        if (m.buildBg && m.buildBg.IsValid()) {
            m.buildBg.style.height = (editing ? m.buildBgH : 0).toFixed(2) + "px";
        }
    }

    // The catalog pages draw a 1825x1618 picture behind the item lists. Vanilla fits it to the 960px-tall
    // window: the Weapon / Spirit / Vitality pages stretch it (100% 100%), the others "cover" it, which in a
    // window taller than the picture's shape enlarges it to the full height and cuts off its right side. So in
    // a taller window every page stretches it, and the tier rows the Weapon / Spirit / Vitality pages place at
    // a fixed y (vanilla citadel_shop_mods_filtered.css) move down with the picture. The stretch is measured:
    // g = picture box height / its vanilla height, and a row that starts o below the picture's top (o: offset of
    // #ModTiers in the picture box) moves by (y + o) * (g - 1). They are moved with margin-top, which adds to
    // the game's x/y: `y` is an alias of `position`, so setting it also replaced the rows' x; neither alias can
    // be unset from script (margin-top goes back to 0px, vanilla has none). Rows are cleared again on the other
    // pages, where they flow.
    // Runs on every 50 ms poll; a class marks the rows already moved, so new rows (the game rebuilds them) are
    // caught within one poll and the rest cost a class check.
    var CATALOG_TABS = ["ShowingWeaponOnly", "ShowingSpiritOnly", "ShowingVitalityOnly"];
    var TIER_Y = { 1: 120, 2: 10, 3: 480, 4: 480 };
    var CATALOG_IMG_ASPECT = 1825 / 1618;
    var ROW_MARK = "NarrowHudMovedRow";
    var movedRows = [];
    function catalogTab(m) {
        if (!m.filtered || !m.filtered.IsValid()) { return ""; }
        for (var i = 0; i < CATALOG_TABS.length; i++) {
            if (hasClassUp(m.filtered, CATALOG_TABS[i])) { return CATALOG_TABS[i]; }
        }
        return "";
    }
    var catalogInfo = "";   // for the debug label
    // layout offsets read before the first layout pass come back as huge floats; treat those as 0 (the
    // rows are re-measured on every 0.5 s update)
    function sane(v) { return isFinite(v) && v > 0 && v < 2000 ? v : 0; }
    // The price label sits on a black tab painted into the picture, the item grid (#ModLists) below it in the
    // row's flow. The grid lands at its vanilla fraction of the picture. The label keeps its vanilla distance to
    // the tab's centre, which the stretch moves by tab * (g - 1): the row moves by that, and the grid gets the
    // rest as its own margin-top. TAB_PX: the tabs' vertical centres in the 1618px-tall pictures (weapon,
    // spirit and vitality agree within 3px). (A translate on the label instead was clipped at the row's top
    // edge and drawn under its sticker.) The grid's margin is recorded on it, so its natural offset can be
    // measured back (also across a hot reload).
    var TAB_PX = { 1: 281, 2: 65, 3: 858, 4: 848 }, CATALOG_IMG_H = 1618;
    var GRID_MT_ATTR = "narrowhud_grid_mt";
    function setGridMargin(grid, v) {
        grid.style.marginTop = v.toFixed(2) + "px";
        grid.SetAttributeString(GRID_MT_ATTR, v.toFixed(2));
    }
    function fixCatalog(m, tab, force) {
        var f = m.mainH / SHOP_MAIN_H, info = "catalog tab=" + (tab || "-") + " f=" + f.toFixed(3);
        // the window's shape does not change while the shop is open, so the picture is only ever switched to
        // stretching (never back); checked on the 0.5 s update only
        if (force) {
            try {
                if (m.lists && m.lists.IsValid() && m.lists.actuallayoutwidth > 0 &&
                    m.lists.actuallayoutheight / m.lists.actuallayoutwidth > 1 / CATALOG_IMG_ASPECT) {
                    m.lists.style.backgroundSize = "100% 100%";
                    m.bgStretched = true;
                }
            } catch (e) { log("catalog bg error: " + e); }
        }
        if (m.bgStretched) { info += " bg=stretch"; }
        try {
            if (tab && Math.abs(f - 1) > 0.001 && m.lists && m.lists.IsValid()) {
                if (!m.tiers || !m.tiers.IsValid()) { m.tiers = m.filtered.FindChildTraverse("ModTiers"); }
                if (!m.tiers) { catalogInfo = info + " no tiers"; return; }
                var u = m.lists.actualuiscale_y;                         // real px per shop unit
                var boxH = m.lists.actuallayoutheight / u;
                var g = boxH / (boxH - (m.mainH - SHOP_MAIN_H));        // picture stretch vs vanilla
                var o = sane(offsetInY(m.tiers, m.lists) / u);
                info += " box=" + boxH.toFixed(0) + " g=" + g.toFixed(3) + " o=" + o.toFixed(1) + " c=grid/row/gridmove:";
                var rows = [], n = m.tiers.GetChildCount();
                for (var i = 0; i < n; i++) {
                    var c = m.tiers.GetChild(i);
                    if (!c || !c.BHasClass("tierRow")) { continue; }
                    if (c.BHasClass(ROW_MARK) && !force) { rows.push(c); continue; }
                    // anchor the item grid (#ModLists, below the price label), not the row's top
                    var grid = c.FindChild("ModLists");
                    var applied = grid ? parseFloat(grid.GetAttributeString(GRID_MT_ATTR, "0")) || 0 : 0;
                    var gy = grid ? sane(offsetInY(grid, c) / u - applied) : 0;
                    for (var t in TIER_Y) {
                        if (!c.BHasClass("EModTier_" + t)) { continue; }
                        var rowMove = TAB_PX[t] / CATALOG_IMG_H * (boxH / g) * (g - 1);
                        var gridMove = (TIER_Y[t] + o + gy) * (g - 1);
                        c.style.marginTop = rowMove.toFixed(2) + "px";
                        if (grid) { setGridMargin(grid, gridMove - rowMove); }
                        c.AddClass(ROW_MARK);
                        rows.push(c);
                        info += t + ":" + gy.toFixed(0) + "/" + rowMove.toFixed(0) + "/" + gridMove.toFixed(0) + ",";
                    }
                }
                movedRows = rows;   // rebuilt every pass (also takes over rows a hot-reloaded predecessor moved)
                info += " rows=" + rows.length + "/" + n;
            } else if (movedRows.length) {
                for (var j = 0; j < movedRows.length; j++) {
                    var r = movedRows[j];
                    if (!r.IsValid()) { continue; }
                    r.style.marginTop = "0px";
                    var rg = r.FindChild("ModLists");
                    if (rg) { setGridMargin(rg, 0); }
                    r.RemoveClass(ROW_MARK);
                }
                movedRows = [];
            }
        } catch (e) { movedRows = []; log("catalog rows error: " + e); }
        catalogInfo = info;
    }

    // The build browser popup (layout/popups/citadel_popup_build_browser.xml) is laid out for a 1080px-tall
    // popup canvas: #BuildsContent starts 40px down and its list box (.MainContainer) is a fixed 830px, so a
    // taller canvas leaves the bottom empty: the list box grows by the extra height, like the shop (centring
    // the vanilla-sized content instead was the alternative; the user preferred filling). Since menus have
    // vanilla size, the popup is shown at vanilla size too (popupVanillaK), so the extra height is small.
    var popupMgr = null;
    // Hero select / create roster popup (popups/citadel_popup_roster_select): laid out for a 1080px canvas. On
    // the left, a header and #GridContainer (800x710) with the hero cards in #RosterHeroes (75x124, 4px margins,
    // 20px padding, 9 per row) from the top; PLAY is pinned to the bottom and the hero art on the right fills
    // the screen by itself. The grid gets the extra height and the cards grow with it: ui-scale k on
    // #RosterHeroes, its width held at the grid's 800px so fewer cards fit per row, k the largest whose rows
    // still fit. (Spreading the rows apart and centring the vanilla grid were tried; the user chose this.)
    var CARD_W = 75 + 8, CARD_H = 124 + 8, GRID_PAD = 40;
    function rosterScale(count, gridH) {
        for (var k = 2; k > 1; k -= 0.01) {
            var cols = Math.floor((800 / k - GRID_PAD) / CARD_W);
            if (cols < 1) { continue; }
            if (Math.ceil(count / cols) * CARD_H + GRID_PAD <= gridH / k) { return k; }
        }
        return 1;
    }
    function fixRosterSelect() {
        if (!popupMgr || !popupMgr.IsValid()) { return; }
        for (var i = 0, n = popupMgr.GetChildCount(); i < n; i++) {
            var p = popupMgr.GetChild(i);
            if (!p || p.paneltype !== "CitadelPopupRosterSelect") { continue; }
            var size = pageSize(p);
            var grid = p.FindChildTraverse("GridContainer"), cards = grid && grid.FindChild("RosterHeroes");
            if (!size || !cards) { continue; }
            var extra = Math.max(0, size.h - 1080), count = cards.GetChildCount();
            var key = extra.toFixed(0) + "/" + count;
            if (extra < 1 || p.GetAttributeString("narrowhud_roster", "") === key) { continue; }
            var k = rosterScale(count, 710 + extra);
            grid.style.height = (710 + extra).toFixed(2) + "px";
            cards.style.uiScale = (k * 100).toFixed(2) + "% " + (k * 100).toFixed(2) + "% 100%";
            cards.style.width = (800 / k).toFixed(2) + "px";
            p.SetAttributeString("narrowhud_roster", key);
            log("roster select: extra=" + extra.toFixed(0) + " cards=" + count + " k=" + k.toFixed(2));
        }
    }

    function fixBuildBrowser() {
        if (!popupMgr || !popupMgr.IsValid()) { return; }
        var n = popupMgr.GetChildCount();
        for (var i = 0; i < n; i++) {
            var p = popupMgr.GetChild(i);
            if (!p || p.paneltype !== "PopupBuildBrowser") { continue; }
            fitPanel(p, popupVanillaK);   // vanilla size like the menus (the game's 4:3 layout fits it)
            var u = p.actualuiscale_y;
            if (!(u > 0) || !(p.actuallayoutheight > 0)) { continue; }
            var extra = p.actuallayoutheight / u - 1080;
            var key = extra.toFixed(0);
            if (extra < 1 || p.GetAttributeString("narrowhud_bb", "") === key) { continue; }
            var content = p.FindChild("BuildsContent");
            var main = content && findClass(content, "MainContainer");
            if (!main) { continue; }   // the selector fills in later; try again next poll
            main.style.height = (830 + extra).toFixed(2) + "px";
            p.SetAttributeString("narrowhud_bb", key);
            log("build browser: extra=" + key);
        }
    }

    function watchShop() {
        if (!alive()) { return; }
        try { applyShopMode(false); } catch (e) { log("shop error: " + e); }
        try { fixBuildBrowser(); } catch (e) { log("build browser error: " + e); }
        try { fixRosterSelect(); } catch (e) { log("roster select error: " + e); }
        try { fixCentredPages(); } catch (e) { log("centred page error: " + e); }
        try { fixPostGame(); } catch (e) { log("post-game error: " + e); }
        try { fixMenuPages(); } catch (e) { log("menu page error: " + e); }
        $.Schedule(0.05, watchShop);
    }

    // Development hot reload (DEV_SEQ > 0). The engine caches a script by name and never re-reads it, so every
    // `install.py --loose` adds a new name: layout/narrowhud_dev_<n>.xml including scripts/narrowhud_dev_<n>.vts.
    // Once a second the running script tries to load the next one into an empty panel; BLoadLayout fails until
    // the file exists. The new instance writes its number on the UI root (narrowhud_seq), and every loop of an
    // older instance stops when it sees a different number there. Styles are re-applied by the new instance.
    var SEQ_ATTR = "narrowhud_seq";
    function alive() {
        return !DEV_SEQ || !root || root.GetAttributeString(SEQ_ATTR, "") === String(DEV_SEQ);
    }
    function probeReload() {
        if (!alive()) { return; }
        var next = DEV_SEQ + 1, id = "NarrowHudReload" + next;
        try {
            var host = ctx.FindChild(id);
            if (!host) {
                host = $.CreatePanel("Panel", ctx, id);
                host.hittest = false;
            }
            if (host.BLoadLayout("file://{resources}/layout/narrowhud_dev_" + next + ".xml", false, false)) {
                log("hot reload: loading #" + next);
                return;
            }
        } catch (e) { log("hot reload error: " + e); }
        $.Schedule(1, probeReload);
    }

    function apply(force) {
        var sx = root.actualuiscale_x, sy = root.actualuiscale_y;
        var lw = root.actuallayoutwidth, lh = root.actuallayoutheight;   // real pixels
        if (!(lw > 0) || !(lh > 0) || !(sx > 0) || !(sy > 0)) { return; }   // layout not ready yet
        // HUD region: the whole screen, or the largest centered HUD_ASPECT box inside it
        var rw = lw, rh = lh;
        if (HUD_ASPECT > 0) {
            if (HUD_ASPECT <= lw / lh) { rw = lh * HUD_ASPECT; } else { rh = lw / HUD_ASPECT; }
        }
        var ox = (lw - rw) / 2, oy = (lh - rh) / 2;                       // region offset, real px
        // reference canvas width: narrow screens (engine class AspectRatio4x3: 1440x1080 canvas, stretched
        // unless the screen is exactly 4:3) get the 1920px a 16:9 layout expects; 16:9, 16:10 and 21:9 keep
        // the engine's own canvas width, so UI Size 1.0 leaves them exactly vanilla
        var narrow = hasClassUp(root, "AspectRatio4x3");
        var refW = narrow ? 1920 : lw / sx;
        // reference scale: that canvas fitted to the region width; never enlarge
        var tRef = Math.min(sx, sy, rw / refW);
        var ux = tRef * uiSize / sx, uy = tRef * uiSize / sy;
        // Menus (main menu, post-match, Esc menu) keep the game's own canvas width (1440 on narrow screens, laid
        // out by the game's AspectRatio4x3 rules), only un-stretched; times UI Size like the HUD. Screens built
        // wider than that fit themselves (fitPanel): menuFitK is their scale relative to the menu, the largest
        // that still shows a 1920-wide layout, never above the menu's own. Popups keep the HUD's reference scale
        // (no UI Size); popupVanillaK brings one back to the menu's vanilla size.
        var tMenu = Math.min(sx, sy, rw / (narrow ? 1440 : lw / sx));
        var mx = tMenu * uiSize / sx, my = tMenu * uiSize / sy;
        menuFitK = narrow ? Math.min(1, tRef / (tMenu * uiSize)) : 1;
        popupVanillaK = narrow ? tMenu / tRef : 1;
        var key = [sx, sy, lw, lh, uiSize, narrow].join("|");
        var changed = force || key !== last;
        last = key;
        var state = "px=" + lw.toFixed(0) + "x" + lh.toFixed(0) + " scale=" + sx.toFixed(3) + "," + sy.toFixed(3) +
            " size=" + uiSize.toFixed(2) + (narrow ? " narrow" : " ref=" + refW.toFixed(0)) +
            " -> ui-scale " + (ux * 100).toFixed(2) + "% " + (uy * 100).toFixed(2) + "%" +
            " menus " + (mx * 100).toFixed(2) + "% " + (my * 100).toFixed(2) + "% fit " + menuFitK.toFixed(3);
        if (changed) { log(state + " region=" + rw.toFixed(0) + "x" + rh.toFixed(0)); }
        var n = root.GetChildCount(), others = [], hudCore = null;
        for (var i = 0; i < n; i++) {
            var c = root.GetChild(i);
            if (!c) { continue; }
            var k = keyOf(c);
            if (!k) { others.push((c.id || "-") + ":" + c.paneltype); continue; }
            if (k === "HudCore") { hudCore = c; }
            if (k === "DashboardMain") { dashMain = c; }
            var cx = ux, cy = uy;
            if (MENUS[k]) { cx = mx; cy = my; }
            if (k === "PopupManager") { cx = tRef / sx; cy = tRef / sy; popupMgr = c; }   // popups ignore UI Size
            c.style.uiScale = (cx * 100).toFixed(4) + "% " + (cy * 100).toFixed(4) + "% 100%";
            if (NOREGION[k]) {
                c.style.width = (lw / sx / cx).toFixed(2) + "px";
                c.style.height = (lh / sy / cy).toFixed(2) + "px";
                c.style.marginLeft = "0px"; c.style.marginRight = "0px";
                c.style.marginTop = "0px"; c.style.marginBottom = "0px";
            } else if (FULLSCREEN[k]) {
                // size in the container's own (scaled) units so it covers exactly the region;
                // symmetric margins (root units) place it correctly whether it is left-aligned or centered
                c.style.width = (rw / sx / cx).toFixed(2) + "px";
                c.style.height = (rh / sy / cy).toFixed(2) + "px";
                c.style.marginLeft = (ox / sx).toFixed(2) + "px";
                c.style.marginRight = (ox / sx).toFixed(2) + "px";
                c.style.marginTop = (oy / sy).toFixed(2) + "px";
                c.style.marginBottom = (oy / sy).toFixed(2) + "px";
                if (k === "EscapeMenu") { fixEscapeBackdrop(c, lw, lh, ox, oy, sx, sy, cx, cy); }
                if (k === "HudCore") {
                    // separately, so a failure in one leaves the others (and the debug label) working
                    try { fixShop(c, rw / sx / ux, rh / sy / uy, refW); } catch (e) { log("shop error: " + e); }
                    try { fixHealthBar(c, sx * ux); } catch (e) { log("health bar error: " + e); }
                    try {
                        fixCrosshair(c, narrow, sx, sy, ux, uy, lw, lh, rw / sx / ux, rh / sy / uy, ox, oy);
                    } catch (e) { log("crosshair error: " + e); }
                }
            } else if (ox > 0 || oy > 0) {
                // edge-anchored containers: keep them inside the region (margins are in the root's units)
                c.style.marginLeft = (ox / sx).toFixed(2) + "px";
                c.style.marginRight = (ox / sx).toFixed(2) + "px";
            }
        }
        if (changed) { log("unmatched root children: " + others.join(" ")); }
        if (DEBUG && dbg) {
            // line 1: the scale state; line 2 (HUD): canvas size, health bar and lower-left group x in canvas
            // units; line 3 (HUD): real px per unit at a crosshair pip, the target scale and the game's pip offset
            var u = sx * ux, extra = "canvas=" + (rw / u).toFixed(0) + "x" + (rh / (sy * uy)).toFixed(0);
            if (hudCore) {
                var hb = hudCore.FindChildTraverse("health_and_abilities_container");
                var sm = hudCore.FindChildTraverse("StatsAndModsContainer");
                if (hb) { extra += "  hb x=" + (offsetIn(hb, hudCore) / u).toFixed(1); }
                if (sm) { extra += "  sm x=" + (offsetIn(sm, hudCore) / u).toFixed(1); }
                if (shopMode) {
                    extra += "  shop s=" + shopMode.s.toFixed(3) + " extra h=" + shopMode.extra.toFixed(0) + "\n" + catalogInfo;
                }
                try {
                    var cr = hudCore.FindChildTraverse("crosshair");
                    var rp = cr && cr.FindChildTraverse("RightPip");
                    if (rp) {
                        extra += "\npip scale=" + Number(rp.actualuiscale_x).toFixed(3) + "," + Number(rp.actualuiscale_y).toFixed(3) +
                                 " target=" + crosshairT.toFixed(3) + " fov=" + crosshairFov.toFixed(3) + " tr=" + rp.style.transform;
                        extra += " HudCore at=" + offsetIn(hudCore, root).toFixed(0) + "," + offsetInY(hudCore, root).toFixed(0) + "px" +
                                 " cr at=" + offsetIn(cr, hudCore).toFixed(0) + "," + offsetInY(cr, hudCore).toFixed(0) + "px";
                        extra += targetDebug(hudCore);
                    } else { extra += "\npips not found"; }
                } catch (e) { extra += "\npips error " + e; }
            }
            // the numbers go to the console (and console.log with -condebug) when they change, at most every 2 s;
            // on screen only a small marker that the test build is running (and whether it hit an error)
            var text = "build " + BUILD_ID + (DEV_SEQ ? " #" + DEV_SEQ : "") + "  " + state + "\n" + extra +
                       (lastError ? "\n" + lastError : "");
            var now = Date.now();
            if (text !== lastDbgText && now - lastDbgTime >= 2000) {
                lastDbgText = text; lastDbgTime = now;
                $.Msg(TAG + " label:\n" + text);
            }
            dbg.text = "resize hud: ON" + (DEV_SEQ ? " #" + DEV_SEQ : "") + (lastError ? "  (error, see console)" : "");
        }
    }

    // Main menu pages whose content is one fixed box (.MainContents) made for a 1920x1080 canvas; the panels
    // inside fill whatever height and width they get. The page fits itself to a 1920-wide layout (fitPanel), and
    // the box gets the page height minus vanilla's space above and below it, and on a narrower canvas the page
    // width minus `side` (vanilla margins):
    //  - player profile (citadel_db_page_profile): 1700x900 at 100px from the left, 80px from the top.
    // (The dialogue player, 1680x900 centred, had the same treatment until menus got vanilla size; at 1440 units
    // the game's own 4:3 layout is better.)
    // The game creates a menu page when it is first opened: DashboardMain > ForegroundContainer > DashboardPages
    // (a PageManager) > the page, e.g. #CitadelProfilePage (found 2026-10-24 by searching the tree).
    var MENU_PAGES = [
        { type: "CitadelProfilePage", w: 1700, h: 900, side: 100 + 40, poll: alignProfileStats }
    ];
    // Profile: the stats panel (#StatsBlock) grows by the extra height under its title band. The boxed tiles
    // (#StatsRight, vanilla padding-top 80px) move down by half of it; the plain numbers (#StatsLeft, vanilla
    // margin-top 150px) are centred on the tiles' visible boxes, so the two columns line up by their middles
    // (vanilla's offset between them only looked right next to the band). A tile (.BlockStat, 220px) shows its
    // box (.blockBacker) in its bottom 78%, the diamond icon above. Measured from content, so it re-runs on every
    // poll; the margin applied is recorded on the column so the next measurement adds to it.
    function alignProfileStats(page, extra) {
        if (extra < 1) { return; }
        var block = page.FindChildTraverse("StatsBlock");
        var left = block && block.FindChild("StatsLeft"), right = block && block.FindChild("StatsRight");
        var u = block && block.actualuiscale_y;
        if (!left || !right || !(u > 0)) { return; }
        var pad = (80 + extra / 2).toFixed(2);
        if (right.GetAttributeString("narrowhud_pt", "") !== pad) {
            right.style.paddingTop = pad + "px";
            right.SetAttributeString("narrowhud_pt", pad);
        }
        var boxes = contentSpan(right, block, u, function (c) { return findClass(c, "blockBacker"); });
        var rows = contentSpan(left, block, u, null);
        if (!boxes || !rows) { return; }
        var current = parseFloat(left.GetAttributeString("narrowhud_mt", ""));
        if (isNaN(current)) { current = 150; }
        var want = current + (boxes.top + boxes.bottom) / 2 - (rows.top + rows.bottom) / 2;
        if (Math.abs(want - current) < 0.5) { return; }
        left.style.marginTop = want.toFixed(2) + "px";
        left.SetAttributeString("narrowhud_mt", want.toFixed(2));
    }
    // vertical extent (in `block` units) of a column's visible children, or of a part of each (`part`)
    function contentSpan(col, block, u, part) {
        var top = Infinity, bottom = -Infinity;
        for (var i = 0, n = col.GetChildCount(); i < n; i++) {
            var c = col.GetChild(i);
            if (c && part) { c = part(c); }
            var h = c ? c.actuallayoutheight / u : 0;
            if (!(h > 0)) { continue; }                           // collapsed
            var y = offsetInY(c, block) / u;
            if (!isFinite(y) || Math.abs(y) > 5000) { return null; }   // before layout
            top = Math.min(top, y); bottom = Math.max(bottom, y + h);
        }
        return isFinite(top) ? { top: top, bottom: bottom } : null;
    }
    var dashMain = null, menuPages = {};
    function dashboardPage(type) {
        if (!dashMain || !dashMain.IsValid()) { return null; }
        var fg = dashMain.FindChild("ForegroundContainer");
        var pages = fg && fg.FindChild("DashboardPages");
        if (!pages) { return null; }
        for (var i = 0, n = pages.GetChildCount(); i < n; i++) {
            var p = pages.GetChild(i);
            if (p && p.paneltype === type) { return p; }
        }
        return null;
    }
    // page canvas size in its own units, or null before layout
    function pageSize(p) {
        var ux = p.actualuiscale_x, uy = p.actualuiscale_y;
        if (!(ux > 0) || !(uy > 0) || !(p.actuallayoutheight > 0)) { return null; }
        return { w: p.actuallayoutwidth / ux, h: p.actuallayoutheight / uy };
    }

    // Main menu pages laid out for 1080px whose content (cards in pages the game rebuilds) keeps its vanilla
    // size and moves down by half the extra height, by the top margin of one element (`part`, vanilla `top`).
    // The page fits itself to a 1920-wide layout first (fitPanel):
    //  - Watch Matches (citadel_db_page_watch): .MatchContents, the filters and 4 rows of match cards (2 rows of
    //    taller featured cards on the first pages), 170px down; the title stays at the top. At the game's 1440
    //    units its 2x2 grid breaks into one column.
    // Growing the cards to fill the height was tried (also with each card's content centred); the user
    // preferred centring. Match history had the same treatment until menus got vanilla size: at 1440 units the
    // game's own 4:3 layout fits.
    var CENTRED_PAGES = [
        { type: "CitadelWatchPage", top: 170, part: function (p) { return findClass(p, "MatchContents"); } }
    ];
    function fixCentredPages() {
        for (var i = 0; i < CENTRED_PAGES.length; i++) {
            var spec = CENTRED_PAGES[i], page = menuPages[spec.type];
            if (!page || !page.IsValid()) { page = menuPages[spec.type] = dashboardPage(spec.type); }
            if (!page) { continue; }
            fitPanel(page, menuFitK);
            var size = pageSize(page);
            if (!size) { continue; }
            var extra = Math.max(0, size.h - 1080), key = extra.toFixed(0);
            if (page.GetAttributeString("narrowhud_centred", "") === key) { continue; }
            var part = spec.part(page);
            if (!part) { continue; }
            part.style.marginTop = (spec.top + extra / 2).toFixed(2) + "px";
            page.SetAttributeString("narrowhud_centred", key);
            log(spec.type + ": centred, extra=" + key);
        }
    }

    // Post-match page (post_game/citadel_db_page_post_game_new): a carousel of screens laid out for 1080px. Only
    // two are changed (the team and MVP screens are left alone), each inside its own screen:
    //  - #ScoreboardScreen: match info and two teams of 6 player rows, from the top. It fits itself to a 1920-wide
    //    layout (at the game's 1440 units the right columns are cut off) and to a 1080-tall one (on a shorter page,
    //    UI size above 1 on a wide screen, it ran into the footer buttons); in a taller box it keeps its vanilla
    //    size and moves down by half the extra height (spreading the rows out was tried, not kept).
    //  - #GraphsScreen (match_details_graphs): #Graphs fits itself to a 1920-wide layout like the scoreboard, and
    //    the graph column (.MainCol, max 780px) and the graph in it (.GraphCtn and the UICanvas #Graph, 700px)
    //    grow by the extra height; the lane-stats view shares .MainCol. #Graphs has vanilla margins of 40 a side
    //    and 160 below (parent units), so it is 920 tall on a 1080 page.
    var postGamePage = null;
    function fixPostGame() {
        if (!postGamePage || !postGamePage.IsValid()) { postGamePage = dashboardPage("CitadelPostGameNew"); }
        if (!postGamePage) { return; }
        var size = pageSize(postGamePage);
        if (!size) { return; }

        var sbScreen = postGamePage.FindChildTraverse("ScoreboardScreen");
        var board = sbScreen && sbScreen.FindChild("Scoreboard");
        var scroll = board && findClass(board, "ScoreboardScrollContainer");
        if (scroll) {
            fitPanel(board, Math.min(menuFitK, size.h / 1080));
            var bs = pageSize(board), sbExtra = bs ? Math.max(0, bs.h - 1080) : 0, sbKey = sbExtra.toFixed(0);
            if (bs && board.GetAttributeString("narrowhud_sb", "") !== sbKey) {
                scroll.style.marginTop = (sbExtra / 2).toFixed(2) + "px";
                board.SetAttributeString("narrowhud_sb", sbKey);
                log("post-game scoreboard: extra=" + sbKey);
            }
        }

        var grScreen = postGamePage.FindChildTraverse("GraphsScreen");
        var graphs = grScreen && grScreen.FindChild("Graphs");
        var col = graphs && findClass(graphs, "MainCol"), ctn = graphs && findClass(graphs, "GraphCtn");
        var canvas = ctn && ctn.FindChild("Graph");
        if (col && ctn && canvas) {
            fitPanel(graphs, menuFitK, 80, 160);
            var gs = pageSize(graphs), extra = gs ? Math.max(0, gs.h - 920) : 0, key = extra.toFixed(0);
            if (gs && graphs.GetAttributeString("narrowhud_graphs", "") !== key) {
                col.style.maxHeight = (780 + extra).toFixed(2) + "px";
                ctn.style.height = (700 + extra).toFixed(2) + "px";
                canvas.style.height = (700 + extra).toFixed(2) + "px";
                graphs.SetAttributeString("narrowhud_graphs", key);
                log("post-game graphs: extra=" + key);
            }
        }
    }

    function fixMenuPages() {
        for (var i = 0; i < MENU_PAGES.length; i++) {
            var spec = MENU_PAGES[i], page = menuPages[spec.type];
            if (!page || !page.IsValid()) { page = menuPages[spec.type] = dashboardPage(spec.type); }
            if (!page) { continue; }
            fitPanel(page, menuFitK);
            var size = pageSize(page);
            if (!size) { continue; }
            var w = Math.min(spec.w, size.w - spec.side), h = Math.max(spec.h, size.h - (1080 - spec.h));
            var key = w.toFixed(0) + "x" + h.toFixed(0);
            if (spec.poll) { spec.poll(page, h - spec.h); }
            if (page.GetAttributeString("narrowhud_box", "") === key) { continue; }
            var main = findClass(page, "MainContents");
            if (!main) { continue; }
            main.style.width = w.toFixed(2) + "px";
            main.style.height = h.toFixed(2) + "px";
            page.SetAttributeString("narrowhud_box", key);
            log(spec.type + ": " + key);
        }
    }

    function tick() {
        if (!alive()) { return; }
        try {
            if (!root) { root = findRoot(ctx); }
            apply(false);
        } catch (e) { log("error: " + e); }
        $.Schedule(0.5, tick);
    }

    function init() {
        try {
            root = findRoot(ctx);
            if (DEV_SEQ) { root.SetAttributeString(SEQ_ATTR, String(DEV_SEQ)); }   // stops older instances
            if (DEBUG) {
                var isMenu = (root.paneltype === "CitadelDB" || root.id === "Dashboard");
                var dbgId = isMenu ? "NarrowHudDebugMenu" : "NarrowHudDebugHud";
                dbg = root.FindChild(dbgId) || $.CreatePanel("Label", root, dbgId);   // reused on a script reload
                dbg.style.position = isMenu ? "40px 700px 0px" : "40px 360px 0px";
                dbg.style.color = isMenu ? "#00ccff" : "#00ff00";
                dbg.style.zIndex = "2000000";
                dbg.style.fontSize = "12px";
                dbg.style.backgroundColor = "#00000080";
                dbg.style.padding = "2px 4px";
                dbg.text = "resize hud: ON";
            }
            var reloading = typeof $.DbgIsReloadingScript === "function" ? $.DbgIsReloadingScript() : "n/a";
            log("context=" + ctx.paneltype + "#" + ctx.id + " reloading=" + reloading + " build=" + BUILD_ID +
                " dev=#" + DEV_SEQ);
            apply(true);
        } catch (e) { log("init error: " + e); }
        $.Schedule(0.5, tick);
        $.Schedule(0.05, watchShop);
        if (DEV_SEQ) { $.Schedule(1, probeReload); }
    }

    $.Schedule(0.1, init);
})();
